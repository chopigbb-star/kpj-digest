# 맥미니 실행 설정 (scripts/run-mac.sh가 읽음). 모델 목록: agy models
SUMMARY_MODEL=gemini-3.8-flash-medium
# 한 번 실행에 처리할 최대 호 수 (1호 약 2~3분 → 40호면 2시간 안팎, 실행 간격 4시간)
UPDATE_ARGS="--max-issues 40"

# 읽어주기 음성 (scripts/tts.mjs) — 인준 목소리, 2026-10 호부터, 만든 지 30일 지나면 삭제
EDGE_TTS="$HOME/Projects/local-ai/tts-env/bin/edge-tts"
TTS_VOICE=ko-KR-InJoonNeural
AUDIO_DIR="$HOME/Projects/kpj-digest-audio"
AUDIO_BASE_URL="https://chopigbb-star.github.io/kpj-digest-audio/"
